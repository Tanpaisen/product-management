extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/form-change-multi.pug
block main
    if(role.permissions.includes("blogs_view"))
        h1 Danh sách bài viết
        +messages(5000)
        .card.mb-3
            .card-header Bộ lọc và Tìm kiếm
                .card-body
                    .row
                        .col-6
                            +filter(filterStatus)
                                
                        .col-6 
                            +search()
                .card-body
                    .row 
                        if(role.permissions.includes("blogs_edit") && role.permissions.includes("blogs_delete"))
                            .col-10
                                +formChangeMulti(`${prefixAdmin}/blogs/change-multi?_method=PATCH`)
                        if(role.permissions.includes("blogs_create"))
                            .col-2
                                a.btn.btn-outline-success(href=`${prefixAdmin}/blogs/create`) + Thêm mới  
                    table.table.table-hover.table-sm(change-multi)
                        thead
                            tr
                                if(role.permissions.includes("blogs_edit") && role.permissions.includes("blogs_delete"))
                                    th 
                                        input(
                                            type="checkbox" 
                                            name="checkall"
                                        )
                                th STT
                                th Tiêu đề
                                th Poster
                                th Tóm tắt
                                th Trạng thái
                                th Vị trí
                                th Người tạo
                                th Hành động
                        tbody
                            if blogs && blogs.length
                                each item,index in blogs
                                    tr
                                        if(role.permissions.includes("products_edit") && role.permissions.includes("products_delete"))
                                            td
                                                input(
                                                    type="checkbox" 
                                                    name="id"
                                                    value=item.id
                                                )
                                        td #{index+1}
                                        td #{item.title}
                                        td 
                                            img(src=item.featuredImage, alt=item.title, style="width:80px; height:auto;")
                                        td #{item.description}
                                        td 
                                            if(role.permissions.includes("blogs_edit"))
                                                if(item.status === 'active')  
                                                    a(
                                                        href="javascript:;"
                                                        class="badge bg-success" 
                                                        data-status=item.status
                                                        data-id= item.id
                                                        button-change-status
                                                    ) Hoạt động
                                                else if(item.status === 'restore')  
                                                    a(
                                                        href="javascript:;"
                                                        class="badge bg-danger" 
                                                        data-status=item.status
                                                        data-id= item.id
                                                        button-change-status
                                                    ) Đã bị xóa
                                                else
                                                    a(
                                                        href="javascript:;"
                                                        class="badge bg-danger" 
                                                        data-status=item.status
                                                        data-id=item.id
                                                        button-change-status
                                                    ) Dừng hoạt động
                                            else
                                                if (item.status == "active")
                                                    span.badge.bg-success Hoạt động
                                                else
                                                    span.badge.bg-danger Không hoạt động
                                        td
                                            input(type="number" value=item.position style="width:60px" min="1" name="position")
                                        td #{item.createdBy}
                                        td
                                            if(item.status === 'restore')
                                                if(role.permissions.includes("products_edit") && role.permissions.includes("products_delete"))
                                                    button.btn.btn-sm.btn-success(
                                                        button-restore
                                                        data-id=item.id
                                                    ) Khôi phục
                                                    button.btn.btn-sm.btn-danger(
                                                        button-delete-perpetual
                                                        data-id=item.id
                                                    ) Xóa vĩnh viễn
                                                a.btn.btn-sm.btn-secondary(href=`${prefixAdmin}/blogs/detail/${item.id}`) Chi tiết
                                            else
                                                if role.permissions.includes("blogs_edit")
                                                    a.btn.btn-sm.btn-primary(href=`${prefixAdmin}/blogs/edit/${item.id}`) Sửa
                                                if role.permissions.includes("blogs_delete")
                                                    button.btn.btn-sm.btn-danger(data-id=item.id button-delete) Xóa
                                                a.btn.btn-sm.btn-secondary(href=`${prefixAdmin}/blogs/detail/${item.id}`) Chi tiết
                            else
                                tr
                                    td(colspan="8") Không có dữ liệu


        form(
            action=""
            method="POST"
            id="form-delete"
            data-path=`${prefixAdmin}/blogs/deleteOne`
            )
        form(
            action=""
            method="POST"
            id="form-change"
            data-path=`${prefixAdmin}/blogs/change-status`
            )
        form(
            action=""
            method="POST"
            id="form-restore"
            data-path=`${prefixAdmin}/blogs/restore`
            )
        form(
            action=""
            method="POST"
            id="form-delete-perpetual"
            data-path=`${prefixAdmin}/blogs/delete`
            )
    else
        .alert.alert-warning
            p Tài khoản của bạn hiện chưa được cấp quyền truy cập. 
            p Vui lòng liên hệ quản trị viên để khôi phục dữ liệu nhóm quyền.