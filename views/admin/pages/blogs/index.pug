extends ../../layouts/default.pug

block main
  h1 Danh sách bài viết

  .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      button.btn.btn-sm.btn-outline-success.active Tất cả
      button.btn.btn-sm.btn-outline-success Hoạt động
      button.btn.btn-sm.btn-outline-success Dừng hoạt động
    .card-body
        .row 
            //if(role.permissions.includes("blogs_edit") && role.permissions.includes("blogs_delete"))
            .col-10
                //
            //if(role.permissions.includes("blogs_create"))
            .col-2
                a.btn.btn-outline-success(href=`${prefixAdmin}/blogs/create`) + Thêm mới  
        table.table.table-hover.table-sm
            thead
            tr
                th STT
                th Tiêu đề
                th Danh mục
                th Tóm tắt
                th Trạng thái
                th Người tạo
                th Hành động
            tbody
                each item,index in blogs
                    tr
                        td #{index+1}
                        td #{item.title}
                        td #{item.blog_category}
                        td #{item.description}
                        td 
                            if(item.status == "active")
                                span.badge.bg-success Hoạt động
                            if(item.status == "inactive")
                                span.badge.bg-danger Không hoạt động
                        td
                          //Người tạo
                        td
                            a.btn.btn-sm.btn-primary(href=`${prefixAdmin}/blogs/edit/${item.id}`) Sửa
                            button.btn.btn-sm.btn-danger(data-id=item.id) Xóa
                    