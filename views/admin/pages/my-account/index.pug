extends ../../layouts/default
block main
  .container.my-4
    .card.shadow-sm
      .row.g-0
        .col-md-3.bg-light.d-flex.align-items-center.justify-content-center
          if (user.avatar)
            img.img-fluid.rounded-circle.p-3(src=user.avatar alt="Avatar")
        .col-md-9
          .card-body
            if (user.fullname)
              h2.card-title.mb-3 #{user.fullname}

            if (user.email)
              p.mb-2
                strong Email:
                |  #{user.email}

            if (user.phone)
              p.mb-2
                strong Số điện thoại:
                |  #{user.phone}

            if (role.title)
              p.mb-2
                strong Phân quyền:
                |  #{role.title}

            if (user.status)
              p.mb-3
                strong Trạng thái:
                if (user.status === "active")
                  span.badge.bg-success.ms-2 Hoạt động
                else
                  span.badge.bg-danger.ms-2 Dừng hoạt động

            a.btn.btn-warning(href=`${prefixAdmin}/my-account/edit`) Chỉnh sửa
