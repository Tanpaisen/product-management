extends ../../layouts/default.pug

block main
  if(role.permissions.includes("accounts_view"))
    .m-2
      .card-title.mb-1
        h1.ms-2 Danh sách tài khoản
      .card.mb-3
        .card-header Danh sách
          .card-body
            .row
              .col-10
                if(role.permissions.includes("accounts_create"))
                  .col-2
                    a.btn.btn-outline-success(href=`${prefixAdmin}/accounts/create`) + Thêm mới
            
            table.table.table-hover.table-sm.mt-4(
              checkbox-multi
            )
              thead
                tr
                  if(role.permissions.includes("accounts_edit") && role.permissions.includes("accounts_delete"))
                    th 
                      input(class="form-check-input" type="checkbox" name="checkAll")
                  th STT
                  th Avatar
                  th Họ tên
                  th Email
                  th Phân quyền
                  th Trạng thái
                  th Hành động
                  th Chi tiết
              tbody
                each item, index in records
                  tr
                    if(role.permissions.includes("accounts_edit")  && role.permissions.includes("accounts_delete"))
                      td
                        input(
                          class="form-check-input" 
                          type="checkbox"
                          name="id" 
                          value=item.id
                        )  
                    td #{index+1}
                    td
                      img(
                        src=item.avatar
                        alt=item.fullname
                        width="100px"
                        height="auto"
                      )
                    td #{item.fullname}
                    td #{item.email}
                    td
                      if(item.role) 
                        div #{item.role.title}
                    if(role.permissions.includes("accounts_edit"))
                      td
                        if(item.status === "active")
                          a(
                            href="javascript:;" 
                            class="badge bg-success fs-6"
                            data-status=item.status
                            data-id=item.id
                            button-change-status
                            ) Hoạt động 
                        else
                          a(
                            href="javascript:;" 
                            class="badge bg-danger fs-6"
                            data-status=item.status
                            data-id=item.id
                            button-change-status
                            ) Dừng hoạt động
                    else
                      td
                        if(item.status === "active")
                          span(
                            class="badge bg-success fs-6"
                            ) Hoạt động 
                        else
                          span(
                            class="badge bg-danger fs-6"
                            ) Dừng hoạt động
                    td
                      if(item.id && role.permissions.includes("accounts_edit"))
                        a(
                        class="btn btn-warning btn-sm"
                        href=`${prefixAdmin}/accounts/edit/${item.id}`
                        ) Sửa
                      else
                        i(class="bi bi-dash-circle-fill")

                      if(item.id && role.permissions.includes("accounts_delete"))    
                        button(
                          class="btn btn-danger btn-sm ms-1" 
                          data-id=item.id
                          button-delete
                        ) Xóa
                    td
                      a(
                        class="btn btn-secondary btn-sm"
                        href=`${prefixAdmin}/accounts/detail/${item.id}`
                      ) Chi tiết

    form(
      action="" 
      id="form-delete"
      method="post"
      data-path=`${prefixAdmin}/accounts/deleteOne`
    ) 
    form(
      action="" 
      id="form-change"
      method="post"
      data-path=`${prefixAdmin}/accounts/change-status`
    ) 
  else
    .alert.alert-warning
        p Tài khoản của bạn hiện chưa được cấp quyền truy cập. 
        p Vui lòng liên hệ quản trị viên để khôi phục dữ liệu nhóm quyền.
