extends ../../layouts/default.pug

block main
    h1.mb-4 Chi tiết nhóm quyền
    .card.mb-3
        .card-header Thông tin nhóm quyền
        .card-body
            div
                strong Tiêu đề: 
                span #{data.title}
            div
                strong Mô tả: 
                span #{data.description}
            if(role.permissions.includes("roles_edit"))
                a(
                    href=`${prefixAdmin}/roles/edit/${data._id}`
                    class="btn btn-warning mb-2"
                ) Chỉnh sửa