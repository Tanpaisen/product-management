extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug

block main
  h1.mb-4 Trang quản trị nhóm quyền
  +messages(5000)
  
  .card.mb-3
    .card-header Danh sách nhóm quyền
    .card-body
      .row.mb-3
        .col-10
          // Có thể thêm bộ lọc hoặc tìm kiếm ở đây
        .col-2.text-right
          a.btn.btn-outline-success(
            href=`${prefixAdmin}/roles/create`
          ) + Thêm mới

      table(
        class="table table-hover table-sm"
        checkbox-multi
      )
        thead
          tr
            th STT
            th Tiêu đề
            th Mô tả ngắn
            th Hành động

        tbody
          if(role && role.length > 0)
            each item, index in role
              tr
                td #{index + 1}
                td #{item.title}
                td !{item.description}
                td
                  a(
                    class="btn btn-warning btn-sm"
                    href=`${prefixAdmin}/roles/edit/${item.id}`
                  ) Sửa
                  button(
                    class="btn btn-danger btn-sm ml-1"
                    button-delete
                    data-id=item.id
                  ) Xóa
          else
            tr
              td(colspan="4" class="text-center") Chưa có nhóm quyền nào được tạo.

  form(
    id="form-delete"
    method="POST"
    action=""
    data-path=`${prefixAdmin}/roles/deleteOne`
  )

  script(src="/admin/js/role.js")
