extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug
include ../../mixins/table-tree.pug

block main
  if(role.permissions.includes("blogs-category_view"))
    h1 Danh mục bài viết
    +messages(5000)
 
    if(role.permissions.includes("blogs-category_create"))
        a.btn.btn-success(href=`${prefixAdmin}/blogs-category/create`) Thêm danh mục mới

    table.table.table-bordered.mt-3
        thead
            tr
                if(role.permissions.includes("blogs-category_edit") && role.permissions.includes("products-category_delete"))
                                th 
                                    input(
                                        type="checkbox" 
                                        name="checkall"
                                    )
                th STT
                th Hình ảnh
                th Tiêu đề
                th Vị trí
                th Trạng thái
                th Người tạo
                th Ngày tạo
                th Hành động
        tbody
            +tableTree(blogsCategory)
    form(
        data-path=`${prefixAdmin}/blogs-category/deleteOne`
        action=""
        id="form-delete"
        method="POST"    
    )
  else
        .alert.alert-warning
            p Tài khoản của bạn hiện chưa được cấp quyền truy cập. 
            p Vui lòng liên hệ quản trị viên để khôi phục dữ liệu nhóm quyền.