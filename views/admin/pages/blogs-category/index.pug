extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug

block main
  if(role.permissions.includes("blogs-category_view"))
    h1 Danh mục bài viết
    +messages(5000)
 
    if(role.permissions.includes("blogs-category_create"))
        a.btn.btn-success(href=`${prefixAdmin}/blogs-category/create`) Thêm danh mục mới

    table.table.table-bordered.mt-3
        thead
            tr
                th Tên danh mục
                th Mô tả
                th Trạng thái
                th Vị trí
                th Hành động
        tbody
            each item,index in blogsCategory
                tr
                    td #{item.title}
                    td #{item.description}
                    td 
                        span.badge.bg-success Hoạt động
                    td 1
                    td
                        if(role.permissions.includes("blogs-category_edit"))
                            a.btn.btn-sm.btn-primary(href=`${prefixAdmin}/blogs-category/edit/${item.id}`) Sửa
                        button.btn.btn-sm.btn-danger(type="button") Xóa
                        a.btn.btn-sm.btn-secondary(href=`${prefixAdmin}/blogs-category/detail/${item.id}`) Chi tiết
  else
        .alert.alert-warning
            p Tài khoản của bạn hiện chưa được cấp quyền truy cập. 
            p Vui lòng liên hệ quản trị viên để khôi phục dữ liệu nhóm quyền.