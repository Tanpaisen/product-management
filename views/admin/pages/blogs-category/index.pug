extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug
include ../../mixins/table-tree.pug
include ../../mixins/filter-status.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/pagination.pug


block main
  if(role.permissions.includes("blogs-category_view"))
    h1 Danh mục bài viết
    +messages(5000)
    .card.mb-3
            .card-header Bộ lọc và Tìm kiếm
                .card-body
                    .row
                        .col-6
                            +filter(filterStatus)
                        .col-6 
                            form(id="form-search")
                                .input-group
                                    input(
                                        type="text"
                                        placeholder="Nhập từ khóa"
                                        name="keyword"
                                        class="form-control"
                                        value=keyword
                                    )
                                    .input-group-append
                                        button(
                                            class="btn btn-success"
                                            type="submit"
                                        ) Tìm
                .card-body
                    .row 
                        if(role.permissions.includes("blogs-category_create") && role.permissions.includes("blogs-category_delete"))
                            .col-10
                                +formChangeMulti(`${prefixAdmin}/blogs-category/change-multi?_method=PATCH`)
                        if(role.permissions.includes("blogs-category_create"))
                            .col-2 
                                a.btn.btn-success(href=`${prefixAdmin}/blogs-category/create`) Thêm danh mục mới

                        table.table.table-bordered.mt-3(change-multi)
                            thead
                                tr
                                    if(role.permissions.includes("blogs-category_edit") && role.permissions.includes("products-category_delete"))
                                        th 
                                            input(
                                                type="checkbox" 
                                                name="checkall"
                                            )
                                    th STT
                                    th Hình ảnh
                                    th Tiêu đề
                                    th Vị trí
                                    th Trạng thái
                                    th Người tạo
                                    th Ngày tạo
                                    th Hành động
                            tbody
                                +tableTree(blogsCategory,"","blogs-category")
    +pagination(pageObject)
    form(
        data-path=`${prefixAdmin}/blogs-category/deleteOne`
        action=""
        id="form-delete"
        method="POST"    
    )
    form(
        data-path=`${prefixAdmin}/blogs-category/delete`
        action=""
        id="form-delete-perpetual"
        method="POST"    
    )
  else
        .alert.alert-warning
            p Tài khoản của bạn hiện chưa được cấp quyền truy cập. 
            p Vui lòng liên hệ quản trị viên để khôi phục dữ liệu nhóm quyền.