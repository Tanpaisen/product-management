extends ../../layouts/default.pug
include ../../mixins/alert-flash.pug
include ../../mixins/box-head.pug


block main
  .container.my-4
    .row
        .col-12
            +box-head("Danh sách phòng chat")
    .row.mb-3
        .col-12
            a(
                href='/rooms-chat/create'
                class="btn btn-sm btn-success mr-1"
            ) Tạo phòng chat
    .row
        .col-6  
            div(class='box-room')
                div(class='inner-avatar')
                    img(
                        src='https://robohash.org/hicveldicta.png'
                        alt="Phòng abc"
                    )
                div(class='inner-info')
                    div(class='inner-name') Phòng abc
                    div(class='inner-buttons')
                        a(
                            href='#'
                            class='btn btn-sm btn-primary mr-1'
                        ) Nhắn tin

                    
        
        //-    else
        //-     p(zero-accept) Bạn chưa gửi lời mời kết bạn nào.
block script 
    script(src="/js/users.js") 