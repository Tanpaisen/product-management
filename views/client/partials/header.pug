include ../mixins/sub-menu.pug

header.header
  .container
    .row.align-items-center
      .col-1.header-item
        .inner-logo
          a(href="/")
            img(src="/images/logo.jpg", alt="Website Logo")
      .col-5.header-item
        form(id="form-search" action="/search")
          .input-group
              input(
                  type="text"
                  placeholder="Nhập từ khóa"
                  name="keyword"
                  class="form-control"
              )
              .input-group-append
                  button(
                      class="btn btn-success"
                      type="submit"
                  ) Tìm
      .col-4.header-item
        .inner-menu
          ul
            li
              a(href="/") Trang chủ
            li.sub-menu
              a(href="/products") Sản phẩm
              span.toggle-submenu
              +sub-menu(productsCategory, "products")
            li
              a(href="/cart") Giỏ hàng (#{cart ? cart.totalQuantity : '0'})
            if(!user)  
              li
                a(href="/user/register") Đăng ký 
              li
                a(href="/user/login") Đăng nhập 
            else 
              li
                a(href="/user/logout") Đăng xuất 
              

